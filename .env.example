# Cong Node.js server se lang nghe
PORT=3000
NODE_ENV=production

# Doi chuoi nay sang mot chuoi bi mat dai, ngau nhien khi deploy that
SESSION_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-ngau-nhien-that-dai

# Tai khoan dang nhap trang quan tri (/admin)
# Chi duoc dung 1 LAN DUY NHAT de tao tai khoan admin khi chay `npm run db:init`.
# Sau khi da tao xong, nen doi mat khau ngay trong trang quan tri va co the xoa 2 dong nay khoi .env that.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay-ngay
