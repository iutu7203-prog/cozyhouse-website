<!DOCTYPE html>
<html lang="vi">
<%- include('partials/head', { title }) %>
<body class="hero-dark">
<%- include('partials/header', { navbarOverlay: true }) %>

<section class="hero hero-dark">
  <div class="hero-decor" aria-hidden="true">
    <span class="hero-blob hero-blob-1"></span>
    <span class="hero-blob hero-blob-2"></span>
    <span class="hero-blob hero-blob-3"></span>
  </div>
  <div class="container hero-grid">
    <div>
      <h1 class="hero-title hero-enter hero-enter-1">
        <% var titleWords = settings.hero_title.trim().split(' '); var titleLast = titleWords.pop(); %>
        <%= titleWords.join(' ') %> <span class="accent"><%= titleLast %></span>
      </h1>
      <p class="hero-subtitle hero-enter hero-enter-2"><%= settings.hero_subtitle %></p>
      <div class="hero-actions hero-enter hero-enter-3">
        <a href="/bang-gia" class="btn btn-primary">
          Xem phòng trống
          <%- include('partials/icon', { name: 'arrow', cls: 'icon-16' }) %>
        </a>
        <a href="<%= fmt.zaloLink(settings.zalo) %>" target="_blank" rel="noopener" class="btn btn-outline">
          <%- include('partials/icon', { name: 'chat', cls: 'icon-20' }) %>
          Nhắn Zalo
        </a>
      </div>
    </div>
    <div class="hero-visual hero-enter hero-enter-3">
      <img src="/images/placeholder-156-hero.svg" alt="Ảnh minh họa mặt tiền Cozy House" width="640" height="800" loading="eager">
    </div>
  </div>
</section>
<svg class="wave-divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0,32 C240,80 480,0 720,24 C960,48 1200,88 1440,40 L1440,80 L0,80 Z"></path>
</svg>

<section class="section section-notop">
  <div class="container">
    <div class="u-text-center">
      <span class="section-eyebrow reveal">Phòng nổi bật</span>
      <h2 class="section-title reveal reveal-delay-1">Những căn phòng đang được yêu thích</h2>
      <p class="section-lead reveal reveal-delay-2 u-center-block">Nội thất đầy đủ, sẵn sàng dọn vào ở ngay tại cả 2 chi nhánh Cozy House.</p>
    </div>

    <div class="carousel u-mt-8 reveal reveal-delay-2">
      <button type="button" class="carousel-arrow prev" aria-label="Phòng trước">
        <%- include('partials/icon', { name: 'chevronLeft' }) %>
      </button>
      <div class="carousel-track">
        <% featuredRooms.forEach(function(room) { %>
          <div class="carousel-item">
            <a href="/phong/<%= room.slug %>" class="feature-card">
              <div class="feature-card-img">
                <img src="<%= room.image %>" alt="Ảnh minh họa <%= room.name %>" loading="lazy">
                <span class="feature-tag">
                  <%- include('partials/icon', { name: 'bed', cls: 'icon-14' }) %>
                  <%= fmt.roomTypeLabel(room.room_type) %>
                </span>
              </div>
              <div class="feature-card-body">
                <h3 class="feature-card-title"><%= room.name %></h3>
                <p class="feature-card-meta">
                  <%- include('partials/icon', { name: 'pin', cls: 'icon-14' }) %>
                  <%= room.location_name %>
                </p>
                <div class="feature-card-price"><%= fmt.formatCurrency(room.price) %> <small>/ tháng</small></div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
      <button type="button" class="carousel-arrow next" aria-label="Phòng tiếp theo">
        <%- include('partials/icon', { name: 'chevronRight' }) %>
      </button>
      <div class="carousel-dots"></div>
    </div>
  </div>
</section>

<section class="section section-notop">
  <div class="container">
    <div class="stats-band reveal">
      <span class="section-eyebrow">An tâm lựa chọn</span>
      <h2 class="section-title">Cho thuê minh bạch, hỗ trợ tận tình</h2>
      <p class="section-lead">Cozy House quản lý trực tiếp bởi <%= settings.owner_name %>, cam kết đúng như mô tả - không phát sinh chi phí ẩn.</p>
      <div class="stats-band-grid u-mt-8">
        <div class="stats-big-number">
          <div class="num" data-count-to="13">0</div>
          <div class="label">Phòng full nội thất</div>
        </div>
        <div class="stats-row stats-row-flat">
          <div class="stats-row-item">
            <span class="icon-badge"><%- include('partials/icon', { name: 'building', cls: 'icon-18' }) %></span>
            <div>
              <div class="val" data-count-to="2" data-count-pad="2">00</div>
              <div class="lbl">Chi nhánh Cộng Hòa</div>
            </div>
          </div>
          <div class="stats-row-item">
            <span class="icon-badge"><%- include('partials/icon', { name: 'shield', cls: 'icon-18' }) %></span>
            <div>
              <div class="val">24/7</div>
              <div class="lbl">An ninh giám sát</div>
            </div>
          </div>
          <div class="stats-row-item">
            <span class="icon-badge"><%- include('partials/icon', { name: 'elevator', cls: 'icon-18' }) %></span>
            <div>
              <div class="val">Có</div>
              <div class="lbl">Thang máy (CH 156)</div>
            </div>
          </div>
          <div class="stats-row-item">
            <span class="icon-badge"><%- include('partials/icon', { name: 'zap', cls: 'icon-18' }) %></span>
            <div>
              <div class="val">Rõ ràng</div>
              <div class="lbl">Chi phí điện, nước, dịch vụ</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="u-text-center">
      <span class="section-eyebrow reveal">Tiện ích</span>
      <h2 class="section-title reveal reveal-delay-1">Đầy đủ những gì bạn cần</h2>
    </div>
    <div class="service-row u-mt-8">
      <div class="service-item reveal reveal-delay-1">
        <div class="service-icon"><%- include('partials/icon', { name: 'bed', cls: 'icon-24' }) %></div>
        <p class="service-title">Nội thất đầy đủ</p>
        <p class="service-desc">Giường, tủ, bàn trang điểm, tủ lạnh, máy lạnh, máy giặt, WC riêng.</p>
      </div>
      <div class="service-item reveal reveal-delay-2">
        <div class="service-icon"><%- include('partials/icon', { name: 'shield', cls: 'icon-24' }) %></div>
        <p class="service-title">An toàn, an ninh</p>
        <p class="service-desc">PCCC và an ninh hiện đại, có thang máy tại Cozy House 156.</p>
      </div>
      <div class="service-item reveal reveal-delay-3">
        <div class="service-icon"><%- include('partials/icon', { name: 'zap', cls: 'icon-24' }) %></div>
        <p class="service-title">Chi phí minh bạch</p>
        <p class="service-desc">Điện <%= fmt.formatCurrency(settings.electricity_price) %>/kWh, nước <%= fmt.formatCurrency(settings.water_price) %>/người.</p>
      </div>
      <div class="service-item reveal reveal-delay-4">
        <div class="service-icon"><%- include('partials/icon', { name: 'pin', cls: 'icon-24' }) %></div>
        <p class="service-title">Vị trí trung tâm</p>
        <p class="service-desc">Trục đường Cộng Hòa, Bảy Hiền - Tân Bình, gần sân bay.</p>
      </div>
      <div class="service-item reveal reveal-delay-5">
        <div class="service-icon"><%- include('partials/icon', { name: 'chat', cls: 'icon-24' }) %></div>
        <p class="service-title">Phản hồi nhanh</p>
        <p class="service-desc">Liên hệ Zalo hoặc điện thoại, hỗ trợ xem phòng nhanh chóng.</p>
      </div>
      <div class="service-item reveal reveal-delay-6">
        <div class="service-icon"><%- include('partials/icon', { name: 'tool', cls: 'icon-24' }) %></div>
        <p class="service-title">Chủ nhà hỗ trợ trực tiếp</p>
        <p class="service-desc">Quản lý bởi <%= settings.owner_name %>, xử lý sự cố nhanh chóng.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-notop">
  <div class="container">
    <div class="u-text-center">
      <span class="section-eyebrow reveal">Không gian sống</span>
      <h2 class="section-title reveal reveal-delay-1">Không gian tại Cozy House</h2>
    </div>

    <div class="carousel u-mt-8 reveal reveal-delay-2">
      <button type="button" class="carousel-arrow prev" aria-label="Ảnh trước">
        <%- include('partials/icon', { name: 'chevronLeft' }) %>
      </button>
      <div class="carousel-track">
        <div class="carousel-item">
          <a href="/co-so/156-cong-hoa" class="feature-card">
            <div class="feature-card-img">
              <img src="/images/placeholder-balcony-3.svg" alt="Phòng ban công thoáng mát" loading="lazy">
              <span class="feature-tag"><%- include('partials/icon', { name: 'image', cls: 'icon-14' }) %> Phòng ban công</span>
            </div>
            <div class="feature-card-body">
              <h3 class="feature-card-title">Phòng ban công thoáng mát</h3>
              <p class="feature-card-meta mb-0">Đón sáng tự nhiên, không khí trong lành</p>
            </div>
          </a>
        </div>
        <div class="carousel-item">
          <a href="/co-so/220-cong-hoa" class="feature-card">
            <div class="feature-card-img">
              <img src="/images/placeholder-interior-3.svg" alt="Phòng khép kín riêng tư" loading="lazy">
              <span class="feature-tag"><%- include('partials/icon', { name: 'image', cls: 'icon-14' }) %> Phòng trong</span>
            </div>
            <div class="feature-card-body">
              <h3 class="feature-card-title">Không gian riêng tư, khép kín</h3>
              <p class="feature-card-meta mb-0">Yên tĩnh, đầy đủ nội thất tiện nghi</p>
            </div>
          </a>
        </div>
        <div class="carousel-item">
          <a href="/co-so/156-cong-hoa" class="feature-card">
            <div class="feature-card-img">
              <img src="/images/placeholder-entrance.svg" alt="Sảnh vào và thang máy Cozy House 156" loading="lazy">
              <span class="feature-tag"><%- include('partials/icon', { name: 'elevator', cls: 'icon-14' }) %> Thang máy</span>
            </div>
            <div class="feature-card-body">
              <h3 class="feature-card-title">Cozy House 156</h3>
              <p class="feature-card-meta mb-0">Sảnh vào, có thang máy phục vụ di chuyển</p>
            </div>
          </a>
        </div>
        <div class="carousel-item">
          <a href="/co-so/156-cong-hoa" class="feature-card">
            <div class="feature-card-img">
              <img src="/images/placeholder-security.svg" alt="Hệ thống an ninh và PCCC hiện đại" loading="lazy">
              <span class="feature-tag"><%- include('partials/icon', { name: 'shield', cls: 'icon-14' }) %> An ninh - PCCC</span>
            </div>
            <div class="feature-card-body">
              <h3 class="feature-card-title">An ninh - PCCC hiện đại</h3>
              <p class="feature-card-meta mb-0">Hệ thống báo cháy, camera giám sát tại Cozy House 156</p>
            </div>
          </a>
        </div>
        <div class="carousel-item">
          <a href="/co-so/156-cong-hoa" class="feature-card">
            <div class="feature-card-img">
              <img src="/images/placeholder-156-hero.svg" alt="Mặt tiền Cozy House 156" loading="lazy">
              <span class="feature-tag"><%- include('partials/icon', { name: 'building', cls: 'icon-14' }) %> Chi nhánh 156</span>
            </div>
            <div class="feature-card-body">
              <h3 class="feature-card-title">Cozy House 156</h3>
              <p class="feature-card-meta mb-0">156/1/17 Cộng Hòa, Phường Bảy Hiền</p>
            </div>
          </a>
        </div>
        <div class="carousel-item">
          <a href="/co-so/220-cong-hoa" class="feature-card">
            <div class="feature-card-img">
              <img src="/images/placeholder-220-hero.svg" alt="Mặt tiền Cozy House 220" loading="lazy">
              <span class="feature-tag"><%- include('partials/icon', { name: 'building', cls: 'icon-14' }) %> Chi nhánh 220</span>
            </div>
            <div class="feature-card-body">
              <h3 class="feature-card-title">Cozy House 220</h3>
              <p class="feature-card-meta mb-0">Ấm cúng, riêng tư, ngay mặt tiền Cộng Hòa</p>
            </div>
          </a>
        </div>
      </div>
      <button type="button" class="carousel-arrow next" aria-label="Ảnh tiếp theo">
        <%- include('partials/icon', { name: 'chevronRight' }) %>
      </button>
      <div class="carousel-dots"></div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/floating-contact') %>
<script src="/js/main.js"></script>
</body>
</html>
