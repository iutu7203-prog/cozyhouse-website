<!DOCTYPE html>
<html lang="vi">
<%- include('../partials/head', { title }) %>
<body>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <h1 class="mb-0">Sửa phòng: <%= room.name %></h1>
        <p class="section-lead mb-0"><%= location.name %></p>
      </div>
      <a href="/admin" class="btn btn-outline btn-sm">Quay lại</a>
    </div>

    <% if (saved) { %><div class="form-success">Đã lưu thay đổi.</div><% } %>
    <% if (created) { %><div class="form-success">Đã tạo phòng mới thành công.</div><% } %>

    <div class="admin-card">
      <form action="/admin/phong/<%= room.id %>" method="POST" enctype="multipart/form-data" data-loading-submit>
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label" for="name">Tên phòng</label>
            <input type="text" id="name" name="name" value="<%= room.name %>" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="room_type">Loại phòng</label>
            <select id="room_type" name="room_type">
              <option value="balcony" <%= room.room_type === 'balcony' ? 'selected' : '' %>>Phòng ban công</option>
              <option value="interior" <%= room.room_type === 'interior' ? 'selected' : '' %>>Phòng trong</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label class="form-label" for="price">Giá / tháng (VNĐ)</label>
            <input type="number" id="price" name="price" min="0" step="100000" value="<%= room.price %>" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="status">Trạng thái</label>
            <select id="status" name="status">
              <option value="available" <%= room.status === 'available' ? 'selected' : '' %>>Còn trống</option>
              <option value="occupied" <%= room.status === 'occupied' ? 'selected' : '' %>>Đã cho thuê</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="area_m2">Diện tích (m², để trống nếu chưa rõ)</label>
          <input type="number" id="area_m2" name="area_m2" min="0" step="0.1" value="<%= room.area_m2 || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="amenities">Tiện nghi (cách nhau bằng dấu phẩy)</label>
          <input type="text" id="amenities" name="amenities" value="<%= room.amenities %>">
          <p class="form-help">VD: Giường nệm, Tủ quần áo, Bàn trang điểm, Tủ lạnh, Máy lạnh, Máy giặt, WC riêng</p>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Mô tả thêm (hiển thị ở trang chi tiết phòng)</label>
          <textarea id="description" name="description" rows="4"><%= room.description %></textarea>
        </div>

        <div class="form-group mb-0">
          <label class="form-label">Ảnh đại diện (hiển thị ở danh sách phòng, trang chủ)</label>
          <div class="current-image-preview">
            <img src="<%= room.image %>" alt="Ảnh hiện tại của <%= room.name %>">
          </div>
          <input type="file" name="image" accept="image/jpeg,image/png,image/webp">
          <p class="form-help">Ảnh JPG/PNG/WEBP, tối đa 4MB. Để trống nếu không muốn đổi ảnh.</p>
        </div>

        <button type="submit" class="btn btn-primary u-mt-5">Lưu thay đổi</button>
      </form>
    </div>

    <div class="admin-card">
      <h3>Thư viện ảnh chi tiết phòng (<%= galleryImages.length + 1 %> ảnh)</h3>
      <p class="section-lead mb-0">Các ảnh này hiển thị thêm ở trang chi tiết phòng, bên cạnh ảnh đại diện phía trên.</p>

      <% if (imageAdded) { %><div class="form-success u-mt-5">Đã thêm ảnh vào thư viện.</div><% } %>
      <% if (imageDeleted) { %><div class="form-success u-mt-5">Đã xóa ảnh khỏi thư viện.</div><% } %>

      <div class="gallery-grid u-mt-5">
        <div class="gallery-thumb">
          <img src="<%= room.image %>" alt="Ảnh đại diện của <%= room.name %>">
          <span class="badge">Ảnh đại diện</span>
        </div>
        <% galleryImages.forEach(function(img) { %>
          <div class="gallery-thumb">
            <img src="<%= img.image %>" alt="Ảnh phòng <%= room.name %>">
            <form action="/admin/phong/<%= room.id %>/anh/<%= img.id %>/xoa" method="POST" data-confirm="Xóa ảnh này khỏi thư viện?">
              <button type="submit" class="gallery-thumb-delete" aria-label="Xóa ảnh này">&times;</button>
            </form>
          </div>
        <% }) %>
      </div>

      <form action="/admin/phong/<%= room.id %>/anh" method="POST" enctype="multipart/form-data" class="u-mt-8" data-loading-submit>
        <div class="form-group mb-0">
          <label class="form-label" for="gallery-image">Thêm ảnh mới vào thư viện</label>
          <input type="file" id="gallery-image" name="image" accept="image/jpeg,image/png,image/webp" required>
          <p class="form-help">Ảnh JPG/PNG/WEBP, tối đa 4MB.</p>
        </div>
        <button type="submit" class="btn btn-outline u-mt-5">Thêm ảnh</button>
      </form>
    </div>

    <div class="admin-card">
      <h3>Xóa phòng</h3>
      <p class="section-lead">Xóa vĩnh viễn phòng này khỏi website. Hành động không thể hoàn tác.</p>
      <form action="/admin/phong/<%= room.id %>/xoa" method="POST" data-confirm="Xóa phòng &quot;<%= room.name %>&quot;? Hành động này không thể hoàn tác.">
        <button type="submit" class="btn btn-danger">Xóa phòng này</button>
      </form>
    </div>
  </main>
</div>
<script src="/js/main.js"></script>
</body>
</html>
