<!DOCTYPE html>
<html lang="vi">
<%- include('../partials/head', { title }) %>
<body>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <h1 class="mb-0">Thêm phòng mới</h1>
        <p class="section-lead mb-0"><%= location.name %></p>
      </div>
      <a href="/admin" class="btn btn-outline btn-sm">Quay lại</a>
    </div>

    <% if (error) { %><div class="form-error"><%= error %></div><% } %>

    <div class="admin-card">
      <form action="/admin/co-so/<%= location.id %>/phong-moi" method="POST" enctype="multipart/form-data" data-loading-submit>
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label" for="name">Tên phòng <span class="required">*</span></label>
            <input type="text" id="name" name="name" value="<%= formData.name || '' %>" placeholder="VD: Phòng Ban Công 4" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="room_type">Loại phòng</label>
            <select id="room_type" name="room_type">
              <option value="balcony" <%= formData.room_type === 'balcony' ? 'selected' : '' %>>Phòng ban công</option>
              <option value="interior" <%= formData.room_type === 'interior' ? 'selected' : '' %>>Phòng trong</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label class="form-label" for="price">Giá / tháng (VNĐ)</label>
            <input type="number" id="price" name="price" min="0" step="100000" value="<%= formData.price || 7500000 %>" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="status">Trạng thái</label>
            <select id="status" name="status">
              <option value="available" <%= formData.status !== 'occupied' ? 'selected' : '' %>>Còn trống</option>
              <option value="occupied" <%= formData.status === 'occupied' ? 'selected' : '' %>>Đã cho thuê</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="area_m2">Diện tích (m², để trống nếu chưa rõ)</label>
          <input type="number" id="area_m2" name="area_m2" min="0" step="0.1" value="<%= formData.area_m2 || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="amenities">Tiện nghi (cách nhau bằng dấu phẩy)</label>
          <input type="text" id="amenities" name="amenities" value="<%= formData.amenities || '' %>">
          <p class="form-help">VD: Giường nệm, Tủ quần áo, Bàn trang điểm, Tủ lạnh, Máy lạnh, Máy giặt, WC riêng</p>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Mô tả thêm (hiển thị ở trang chi tiết phòng)</label>
          <textarea id="description" name="description" rows="4"><%= formData.description || '' %></textarea>
        </div>

        <div class="form-group mb-0">
          <label class="form-label">Ảnh phòng</label>
          <input type="file" name="image" accept="image/jpeg,image/png,image/webp">
          <p class="form-help">Ảnh JPG/PNG/WEBP, tối đa 4MB. Để trống sẽ dùng ảnh minh họa mặc định theo loại phòng.</p>
        </div>

        <button type="submit" class="btn btn-primary u-mt-5">Thêm phòng</button>
      </form>
    </div>
  </main>
</div>
<script src="/js/main.js"></script>
</body>
</html>
